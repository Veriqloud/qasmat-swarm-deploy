networks:
  my-overlay-net:
    external: true

services:
  keycloak:
    image: quay.io/keycloak/keycloak
    command: start
    environment:
      KC_HOSTNAME: "{{ keycloak_dns }}"
      KC_HTTP_ENABLED: "true"
      KC_HOSTNAME_STRICT: "true"
      KC_HOSTNAME_STRICT_BACK_CHANNEL: "false"
      KC_PROXY_HEADERS: "xforwarded"
      KC_BOOTSTRAP_ADMIN_USERNAME: "{{ keycloak_admin_user }}"
      KC_BOOTSTRAP_ADMIN_PASSWORD: "{{ keycloak_admin_password }}"
      KC_DB: postgres
      KC_DB_URL: jdbc:postgresql://keycloak-db_keycloak-db:5432/keycloak
      KC_DB_USERNAME: keycloak
      KC_DB_PASSWORD: "{{ keycloak_db_password | default('keycloak_db_pass_change_me') }}"
    networks:
      - my-overlay-net
    restart: always
    deploy:
      placement:
        constraints:
          - node.hostname == {{ hostvars['keycloak']['ansible_hostname'] }}
    expose:
      - "8080"
