networks:
  my-overlay-net:
    external: true

services:
  keycloak-db:
    image: postgres:18
    environment:
      POSTGRES_DB: keycloak
      POSTGRES_USER: keycloak
      POSTGRES_PASSWORD: "{{ keycloak_db_password | default('keycloak_db_pass_change_me') }}"
    volumes:
      - '/keycloak/postgres_data:/var/lib/postgresql'
    networks:
      - my-overlay-net
    restart: always
    deploy:
      placement:
        constraints:
          - node.hostname == {{ hostvars['keycloak']['ansible_hostname'] }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U keycloak -d keycloak"]
      interval: 10s
      timeout: 5s
      retries: 5
